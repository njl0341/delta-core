# delta-core environment configuration
# Copy to .env and set values for your deployment.
# All variables are prefixed with DELTA_CORE_.

# Maximum allowed timestamp delta between a STREAM record and its BATCH counterpart (seconds).
# Default: 86400 (24 hours).  Reduce for tighter settlement windows.
# DELTA_CORE_TIMESTAMP_SKEW_THRESHOLD_SECONDS=86400

# Amount comparison tolerance in decimal.
# Leave at 0.00 for absolute financial fidelity (recommended).
# DELTA_CORE_AMOUNT_TOLERANCE=0.00

# Enable FastAPI debug mode (never set in production)
# DELTA_CORE_DEBUG=false
